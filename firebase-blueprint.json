{
  "entities": {
    "MarketConfig": {
      "title": "MarketConfig",
      "description": "Configuration for night market or fresh market in Mahasarakham municipality",
      "type": "object",
      "properties": {
        "totalStalls": {
          "type": "number",
          "description": "Total stalls available"
        },
        "name": {
          "type": "string",
          "description": "Market name"
        },
        "description": {
          "type": "string",
          "description": "Description of the market"
        },
        "location": {
          "type": "string",
          "description": "Location description"
        }
      },
      "required": ["totalStalls", "name"]
    },
    "MarketLeaseContract": {
      "title": "MarketLeaseContract",
      "description": "Lease contract for municipal market stalls",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Contract unique ID"
        },
        "marketType": {
          "type": "string",
          "enum": ["night", "fresh"],
          "description": "Market category"
        },
        "order": {
          "type": "number",
          "description": "Sequence order"
        },
        "assetName": {
          "type": "string",
          "description": "Stall or asset name"
        },
        "contractNo": {
          "type": "string",
          "description": "Official contract number"
        },
        "tenantName": {
          "type": "string",
          "description": "Name of tenant or operator"
        },
        "startDate": {
          "type": "string",
          "description": "Start date YYYY-MM-DD"
        },
        "duration": {
          "type": "string",
          "description": "Duration text"
        },
        "durationYears": {
          "type": "number",
          "description": "Years"
        },
        "durationMonths": {
          "type": "number",
          "description": "Months"
        },
        "durationDays": {
          "type": "number",
          "description": "Days"
        },
        "endDate": {
          "type": "string",
          "description": "End date YYYY-MM-DD"
        },
        "transactionFee": {
          "type": "number",
          "description": "Transaction fee amount in baht"
        },
        "monthlyRent": {
          "type": "number",
          "description": "Monthly rent in baht"
        },
        "securityDeposit": {
          "type": "number",
          "description": "Security deposit in baht"
        },
        "status": {
          "type": "string",
          "enum": ["active", "expiring_soon", "expired"],
          "description": "Contract status"
        },
        "notes": {
          "type": "string",
          "description": "Remarks or notes"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "marketType", "assetName", "contractNo", "startDate", "endDate", "monthlyRent"]
    },
    "OfficialMemoApproval": {
      "title": "OfficialMemoApproval",
      "description": "Approval status and signatures for the official memorandum",
      "type": "object",
      "properties": {
        "reporterName": {
          "type": "string",
          "description": "Name of reporting officer"
        },
        "reporterTitle": {
          "type": "string",
          "description": "Position of reporting officer"
        },
        "reportedDate": {
          "type": "string",
          "description": "Report date YYYY-MM-DD"
        },
        "isReported": {
          "type": "boolean",
          "description": "Report status"
        },
        "directorName": {
          "type": "string",
          "description": "Finance Director name"
        },
        "directorTitle": {
          "type": "string",
          "description": "Finance Director title"
        },
        "directorStatus": {
          "type": "string",
          "description": "Director verification status"
        },
        "directorComment": {
          "type": "string",
          "description": "Director review comment"
        },
        "directorVerifiedAt": {
          "type": "string",
          "description": "Director verification timestamp"
        },
        "executiveName": {
          "type": "string",
          "description": "Executive Mayor name"
        },
        "executiveTitle": {
          "type": "string",
          "description": "Executive Mayor title"
        },
        "executiveStatus": {
          "type": "string",
          "description": "Executive approval status"
        },
        "executiveComment": {
          "type": "string",
          "description": "Executive order or comment"
        },
        "executiveApprovedAt": {
          "type": "string",
          "description": "Executive approval timestamp"
        }
      },
      "required": ["reporterName", "directorName", "executiveName"]
    },
    "AppDatabase": {
      "title": "AppDatabase",
      "description": "Comprehensive unified database structure for all menus",
      "type": "object",
      "properties": {
        "nightMarketConfig": {
          "type": "object",
          "description": "Night market configuration"
        },
        "freshMarketConfig": {
          "type": "object",
          "description": "Fresh market configuration"
        },
        "contracts": {
          "type": "array",
          "description": "List of all lease contracts"
        },
        "memoApproval": {
          "type": "object",
          "description": "Official memorandum approval record"
        },
        "lastUpdated": {
          "type": "string",
          "description": "Timestamp of latest data update"
        }
      },
      "required": ["nightMarketConfig", "freshMarketConfig", "contracts", "memoApproval", "lastUpdated"]
    }
  },
  "firestore": {
    "/app_state/{stateId}": {
      "schema": "AppDatabase",
      "description": "Central persistent database synchronized across all devices and menus"
    },
    "/contracts/{contractId}": {
      "schema": "MarketLeaseContract",
      "description": "All market lease contracts"
    },
    "/memo_approval/{memoId}": {
      "schema": "OfficialMemoApproval",
      "description": "Official memorandum approvals and signatures"
    }
  }
}
