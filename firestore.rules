rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // App state holding all 5 synchronized menus
    match /app_state/{stateId} {
      allow read, write: if true;
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // Official memorandum approval collection
    match /memo_approval/{memoId} {
      allow read, write: if true;
    }

    // Default match for other collections in the database
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
